<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="wheel_radius" value="0.04" />
    <xacro:property name="wheel_length" value="0.04" />

    <link name="base_footprint" />

    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="file://$(find sbu_robot_description)/meshes/base_link2.STL"
                      scale="0.001 0.001 0.001" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="white" />
        </visual>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="1.96166"/>
            <inertia ixx="1.7307558e-02" ixy="0.0" ixz="-9.3540100e-06"
                     iyy="1.7302023e-02" iyz="0.0"
                     izz="2.8961675e-03"/>
        </inertial>
        <collision>
            <geometry>
                <mesh filename="file://$(find sbu_robot_description)/meshes/base_link.STL"
                      scale="0.001 0.001 0.001" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision> 
                  
    </link> 

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
                <material name="grey" />
            </visual>
            <collision>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
            </collision>
            <xacro:cylinder_inertia m="0.2" r="${wheel_radius}" l="${wheel_length}"
                                    xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
        </link>
    </xacro:macro>

    <xacro:wheel_link prefix="right" />
    <xacro:wheel_link prefix="left" /> 

    <link name="caster_wheel_link_1">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.01"/>
            </geometry>
            <origin xyz="0 0 0.005" rpy="0 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.02" length="0.01"/>
            </geometry>
            <origin xyz="0 0 0.005" rpy="0 0 0" />
        </collision>
        <xacro:cylinder_inertia m="0.1" r="0.02" l="0.01"
                              xyz="0 0 0.005" rpy="0 0 0" />
    </link>     

    <link name="caster_wheel_link_2">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.01"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
            <material name="grey" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.02" length="0.01"/>
            </geometry>
            <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
        </collision>
        <xacro:cylinder_inertia m="0.1" r="0.02" l="0.01"
                              xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
    </link>    


    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0" />
    </joint>
    
    <joint name="base_right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="0.0425 -0.0925 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="0.0425 0.0925 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="caster_wheel_joint_1" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_link_1" />
        <origin xyz="-0.13 0 0" rpy="0 0 0" />
        <axis xyz="0 0 1" />
    </joint>    

    <joint name="caster_wheel_joint_2" type="fixed">
        <parent link="caster_wheel_link_1" />
        <child link="caster_wheel_link_2" />
        <origin xyz="0 0 ${-wheel_radius / 2.0}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>    

</robot>
