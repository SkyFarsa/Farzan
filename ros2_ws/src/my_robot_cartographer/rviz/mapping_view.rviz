Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true

    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LaserScan
      Topic: /scan
      Color: 255; 255; 0
      Size (m): 0.05
      Style: Points
      Queue Size: 10
      Value: true

    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Map
      Topic: /map
      Color Scheme: costmap
      Alpha: 0.7
      Value: true

    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: Trajectory
      Topic: /trajectory
      Color: 25; 255; 0
      Line Style: Lines
      Line Width: 0.05
      Value: true

    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Odom
      Topic: /odom
      Shape: Arrow
      Color: 0; 255; 255
      Axes Length: 0.2
      Axes Radius: 0.02
      Value: true

    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: RobotModel
      Robot Description: robot_description
      TF Prefix: ""
      Value: true

  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Focal Point: [0, 0, 0]
      Pitch: 0.785
      Yaw: 0.785
      Name: Orbit (3D)
      Value: true
